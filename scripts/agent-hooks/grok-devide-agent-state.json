            "command": "sh -c '[ -n \"${DEVIDE_AGENT_MCP_HOME:-}\" ] || exit 0; exec \"${DEVIDE_AGENT_MCP_HOME}/devide-agent-state.sh\"'",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -n \"${DEVIDE_AGENT_MCP_HOME:-}\" ] || exit 0; exec \"${DEVIDE_AGENT_MCP_HOME}/devide-agent-state.sh\"'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -n \"${DEVIDE_AGENT_MCP_HOME:-}\" ] || exit 0; exec \"${DEVIDE_AGENT_MCP_HOME}/devide-agent-state.sh\"'",
            "timeout": 5
          }
        ]
      }
