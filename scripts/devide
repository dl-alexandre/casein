#!/usr/bin/env bash
#
# Casein agent CLI — cwd-independent MCP discovery and agent launch.
#
set -euo pipefail

DEVIDE_SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DEVIDE_ROOT="$(cd "${DEVIDE_SELF}/.." && pwd)"
# shellcheck source=lib/agent-env.sh
source "${DEVIDE_SELF}/lib/agent-env.sh"
# shellcheck source=lib/real-agent-bin.sh
source "${DEVIDE_SELF}/lib/real-agent-bin.sh"

usage() {
  cat <<'EOF'
Usage: devide <command> [args...]

Commands:
  version [--json]                   Show installed/synthesized release metadata
  update check [--json]              Compare installed revision to remote manifest
  agent launch <runtime> [args...]   Launch an agent with Terminal + Preview MCP
  agent env                          Print shell exports (eval "$(devide agent env)")
  agent auth signin <runtime>        Sign in current owner for Claude/Codex
  agent auth signin <owner> <runtime>
                                     Sign in once for <owner>-* workspaces
  agent auth status [workspace] [runtime]
                                     Show owner auth profile and sign-in state
  agent auth list                    List configured owner auth profiles
  agent auth register <owner>        Fail closed: <owner>-* workspaces stop
                                     falling back to the host global login
  agent auth unregister <owner>      Allow global-auth fallback again
  agent doctor [codex]               Health/capability check; codex adds schema/hooks/sandbox
  mcp ensure                         Materialize per-workspace MCP client configs
  tools ensure <tool>                Ensure a supported terminal tool is installed
  ensure-installed <tool>            Compatibility alias for tools ensure

Agents on PATH (grok, claude, codex, opencode, agent) are shimmed; clauded stays a shell alias
automatically after install-agent-shims.sh — just type the command name.
EOF
}

invoke_release_cli() {
  local arg
  local argv=""

  for arg in "$@"; do
    argv+="${arg}"$'\n'
  done

  export DEVIDE_CLI_ARGV="${argv}"
  export CASEIN_RELEASE_CLI=1

  if command -v mise >/dev/null 2>&1; then
    (cd "$DEVIDE_ROOT" && mise exec -- mix eval 'Casein.Release.CLI.main() |> then(&System.halt/1)')
  else
    (cd "$DEVIDE_ROOT" && mix eval 'Casein.Release.CLI.main() |> then(&System.halt/1)')
  fi
}

materialize_mcp() {
  agent_env_resolve
  local script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/materialize-agent-mcp.sh"
  if [[ ! -f "$script" ]]; then
    script="${DEVIDE_ROOT}/scripts/materialize-agent-mcp.sh"
  fi
  bash "$script"
}

# Run materialize_mcp, fail open, but surface the failure. The materializer's
# stdout can contain tokens, so it is captured and redacted rather than echoed.
materialize_mcp_optional() {
  local out err detail
  out="$(mktemp)"
  err="$(mktemp)"

  if ! materialize_mcp >"$out" 2>"$err"; then
    detail="$(<"$err")"
    if [[ -s "$out" ]]; then
      detail="${detail}"$'\n'"materialize-agent-mcp.sh wrote $(wc -c <"$out") bytes to stdout; redacted because it may contain tokens"
    fi
    echo "warn: materialize-agent-mcp.sh failed — continuing in degraded mode" >&2
    if [[ -n "$detail" ]]; then
      printf '%s\n' "${detail:0:1200}" >&2
    fi
  fi

  rm -f "$out" "$err"
}

export_agent_env() {
  agent_env_resolve
  materialize_mcp_optional
  agent_env_export_runtime_paths

  local key
  for key in CASEIN_API_TOKEN DEVIDE_WORKSPACE_ID DEVIDE_WORKSPACE_NAME \
    DEVIDE_API_BASE_URL DEVIDE_TERMINAL_MCP_URL DEVIDE_PREVIEW_MCP_URL DEVIDE_ARTIFACT_MCP_URL DEVIDE_CHECKOUT \
    DEVIDE_AGENT_MCP_HOME DEVIDE_SCRIPTS DEVIDE_AGENT_ENV_FILE \
    CLAUDE_CONFIG_DIR CODEX_HOME PATH; do
    if [[ -n "${!key:-}" ]]; then
      printf 'export %s=%q\n' "$key" "${!key}"
    fi
  done

  if [[ -z "${DEVIDE_SCRIPTS:-}" ]]; then
    printf 'export DEVIDE_SCRIPTS=%q\n' "${DEVIDE_ROOT}/scripts"
  fi
}

agent_auth() {
  local sub="${1:-}"
  shift || true

  case "$sub" in
    signin)
      local script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/lib/agent-auth-login.sh"
      if [[ ! -f "$script" ]]; then
        script="${DEVIDE_ROOT}/scripts/lib/agent-auth-login.sh"
      fi

      local owner="" runtime="" profile_script workspace
      profile_script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/lib/agent-auth-profile.sh"
      if [[ ! -f "$profile_script" ]]; then
        profile_script="${DEVIDE_ROOT}/scripts/lib/agent-auth-profile.sh"
      fi

      case "${1:-}" in
        claude|codex)
          runtime="$1"
          shift || true

          if ! agent_env_resolve >/dev/null 2>&1; then
            echo "error: could not detect owner; run inside a Casein workspace or use: devide agent auth signin <owner> <claude|codex>" >&2
            exit 64
          fi

          workspace="${DEVIDE_WORKSPACE_NAME:-${DEVIDE_WORKSPACE_ID:-}}"
          # shellcheck source=lib/agent-auth-profile.sh
          source "$profile_script"
          owner="$(agent_auth_profile_owner_slug "$workspace" 2>/dev/null || true)"
          if [[ -z "$owner" ]]; then
            echo "error: could not derive owner from workspace: ${workspace}" >&2
            exit 64
          fi
          echo "signing ${runtime} into owner profile: ${owner} (${workspace})" >&2
          ;;
        "")
          echo "usage: devide agent auth signin <claude|codex>  # inside a Casein workspace" >&2
          echo "   or: devide agent auth signin <owner> <claude|codex>" >&2
          exit 64
          ;;
        *)
          if [[ -z "${2:-}" ]]; then
            echo "usage: devide agent auth signin <claude|codex>  # inside a Casein workspace" >&2
            echo "   or: devide agent auth signin <owner> <claude|codex>" >&2
            exit 64
          fi
          owner="$1"
          runtime="$2"
          shift 2
          ;;
      esac

      bash "$script" "$owner" "$runtime" "$@"
      ;;
    status)
      local script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/lib/agent-auth-profile.sh"
      if [[ ! -f "$script" ]]; then
        script="${DEVIDE_ROOT}/scripts/lib/agent-auth-profile.sh"
      fi

      local workspace="${1:-}"
      if [[ -n "$workspace" ]]; then
        shift || true
      else
        if ! agent_env_resolve >/dev/null 2>&1; then
          echo "error: missing workspace (or run inside a Casein agent environment)" >&2
          exit 64
        fi
        workspace="${DEVIDE_WORKSPACE_NAME:-${DEVIDE_WORKSPACE_ID:-}}"
      fi

      if [[ -z "$workspace" ]]; then
        echo "error: missing workspace" >&2
        exit 64
      fi

      bash "$script" --status "$workspace" "$@"
      ;;
    list)
      local script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/lib/agent-auth-profile.sh"
      if [[ ! -f "$script" ]]; then
        script="${DEVIDE_ROOT}/scripts/lib/agent-auth-profile.sh"
      fi
      bash "$script" --list
      ;;
    register|unregister)
      local script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/lib/agent-auth-profile.sh"
      if [[ ! -f "$script" ]]; then
        script="${DEVIDE_ROOT}/scripts/lib/agent-auth-profile.sh"
      fi

      local owner="${1:-}"
      if [[ -z "$owner" ]]; then
        echo "usage: devide agent auth ${sub} <owner>" >&2
        exit 64
      fi
      bash "$script" "--${sub}" "$owner"
      ;;
    -h|--help|help|"")
      echo "usage: devide agent auth <signin|status|list|register|unregister> ..." >&2
      ;;
    *)
      echo "error: unknown agent auth subcommand: $sub" >&2
      exit 1
      ;;
  esac
}

agent_doctor() {
  local script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/lib/agent-doctor.sh"
  if [[ ! -f "$script" ]]; then
    script="${DEVIDE_ROOT}/scripts/lib/agent-doctor.sh"
  fi
  bash "$script" "$@"
}

ensure_terminal_tool() {
  local tool="${1:-}"
  if [[ -z "$tool" ]]; then
    echo "error: missing tool name" >&2
    usage >&2
    exit 64
  fi

  local script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/ensure-terminal-tool.sh"
  if [[ ! -f "$script" ]]; then
    script="${DEVIDE_ROOT}/scripts/ensure-terminal-tool.sh"
  fi

  bash "$script" "$@"
}

agent_runtime_passthrough() {
  local runtime="$1"
  local first="${2:-}"

  # Version/help probes go straight to the real binary for every runtime:
  # they must not resolve env, create a worktree, or inject MCP.
  case "$first" in
    --version|--help|-h)
      return 0
      ;;
  esac

  case "$runtime:$first" in
    codex:update|codex:doctor|codex:help|codex:version|codex:-V|claude:update|claude:-v)
      return 0
      ;;
  esac

  return 1
}

agent_runtime_update_passthrough() {
  local runtime="$1"
  local first="${2:-}"

  [[ "$runtime" == "codex" && "$first" == "update" ]]
}

exec_real_runtime() {
  local runtime="$1"
  shift || true

  local bin
  bin="$(real_agent_bin "$runtime")"
  if [[ -z "$bin" ]]; then
    echo "error: could not find executable for ${runtime}" >&2
    exit 1
  fi

  exec "$bin" "$@"
}

run_codex_update() {
  local bin status

  bash "${DEVIDE_ROOT}/scripts/ensure-devbox-npm-prefix.sh" >&2

  bin="$(real_agent_bin codex)"
  if [[ -z "$bin" ]]; then
    echo "error: could not find executable for codex" >&2
    exit 1
  fi

  set +e
  "$bin" "$@"
  status=$?
  set -e

  if [[ "${DEVIDE_REINSTALL_SHIMS_AFTER_CODEX_UPDATE:-1}" != "0" ]]; then
    if ! bash "${DEVIDE_ROOT}/scripts/install-agent-shims.sh" >&2; then
      echo "warn: codex update completed but Casein shim reinstall failed" >&2
    fi
  fi

  exit "$status"
}

launch_agent() {
  local runtime="${1:-}"
  shift || true

  if [[ -z "$runtime" ]]; then
    echo "error: missing runtime (grok|codex|claude|opencode|agent|...)" >&2
    exit 1
  fi

  if agent_runtime_update_passthrough "$runtime" "${1:-}"; then
    run_codex_update "$@"
  fi

  if agent_runtime_passthrough "$runtime" "${1:-}"; then
    exec_real_runtime "$runtime" "$@"
  fi

  if ! agent_env_resolve 2>/dev/null; then
    # No agent env (plain terminal, or a Casein pane whose pairing is
    # missing): launch the real binary unpaired, silently — operator call:
    # the shim must never add noise to the command it wraps.
    # DEVIDE_AGENT_LAUNCH_VERBOSE=1 explains the fallback on stderr;
    # DEVIDE_AGENT_LAUNCH_STRICT=1 restores the hard failure for callers
    # that would rather abort than run without MCP.
    if [[ "${DEVIDE_AGENT_LAUNCH_STRICT:-0}" == "1" ]]; then
      agent_env_resolve
      exit 1
    fi
    if [[ "${DEVIDE_AGENT_LAUNCH_VERBOSE:-0}" == "1" ]]; then
      echo "devide: no agent env — launching ${runtime} unpaired (no Casein MCP)." >&2
    fi
    agent_env_stamp_pane_pairing 0 "no agent env"
    exec_real_runtime "$runtime" "$@"
  fi
  agent_env_stamp_pane_pairing 1 ""
  agent_env_export_runtime_paths

  # Keep the shim and launcher on the same installed revision. Pairing env can
  # legitimately outlive a checkout update (or point at a user's dirty branch),
  # so preferring DEVIDE_SCRIPTS here can silently route a freshly-installed
  # shim back through stale launch policy. Only fall back to the paired scripts
  # tree when this CLI is itself a standalone copy without a sibling launcher.
  local launcher="${DEVIDE_ROOT}/scripts/launch-casein-agent.sh"
  if [[ ! -f "$launcher" ]]; then
    launcher="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/launch-casein-agent.sh"
  fi

  case "$runtime" in
    grok|codex|claude|opencode|agent)
      # The launcher owns materialization (visible-failure path) for these.
      exec bash "$launcher" "$runtime" "$@"
      ;;
    *)
      # Arbitrary runtimes skip the launcher, so materialize here — fail open
      # but loudly.
      materialize_mcp_optional
      exec_real_runtime "$runtime" "$@"
      ;;
  esac
}

main() {
  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    version|update)
      invoke_release_cli "$cmd" "$@"
      ;;
    agent)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        launch) launch_agent "$@" ;;
        env) export_agent_env ;;
        auth) agent_auth "$@" ;;
        doctor) agent_doctor "$@" ;;
        -h|--help|help|"") usage ;;
        *) echo "error: unknown agent subcommand: $sub" >&2; usage >&2; exit 1 ;;
      esac
      ;;
    mcp)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        ensure) materialize_mcp ;;
        -h|--help|help|"") usage ;;
        *) echo "error: unknown mcp subcommand: $sub" >&2; usage >&2; exit 1 ;;
      esac
      ;;
    tools)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        ensure) ensure_terminal_tool "$@" ;;
        -h|--help|help|"") usage ;;
        *) echo "error: unknown tools subcommand: $sub" >&2; usage >&2; exit 1 ;;
      esac
      ;;
    ensure-installed)
      ensure_terminal_tool "$@"
      ;;
    -h|--help|help|"") usage ;;
    *)
      echo "error: unknown command: $cmd" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
