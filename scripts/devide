#!/usr/bin/env bash
#
# DevIDE agent CLI — cwd-independent MCP discovery and agent launch.
#
set -euo pipefail

DEVIDE_SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DEVIDE_ROOT="$(cd "${DEVIDE_SELF}/.." && pwd)"
# shellcheck source=lib/agent-env.sh
source "${DEVIDE_SELF}/lib/agent-env.sh"
# shellcheck source=lib/real-agent-bin.sh
source "${DEVIDE_SELF}/lib/real-agent-bin.sh"

usage() {
  cat <<'EOF'
Usage: devide <command> [args...]

Commands:
  agent launch <runtime> [args...]   Launch an agent with Terminal + Preview MCP
  agent env                          Print shell exports (eval "$(devide agent env)")
  agent auth signin <runtime>        Sign in current owner for Claude/Codex
  agent auth signin <owner> <runtime>
                                     Sign in once for <owner>-* workspaces
  agent auth status [workspace] [runtime]
                                     Show whether Claude/Codex use global or owner auth
  agent auth list                    List configured owner auth profiles
  agent doctor                       Health check: shims, token, tmux env, MCP endpoints
  mcp ensure                         Materialize per-workspace MCP client configs
  tools ensure <tool>                Ensure a supported terminal tool is installed
  ensure-installed <tool>            Compatibility alias for tools ensure

Agents on PATH (grok, claude, codex, opencode, agent) are shimmed; clauded stays a shell alias
automatically after install-agent-shims.sh — just type the command name.
EOF
}

materialize_mcp() {
  agent_env_resolve
  local script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/materialize-agent-mcp.sh"
  if [[ ! -f "$script" ]]; then
    script="${DEVIDE_ROOT}/scripts/materialize-agent-mcp.sh"
  fi
  bash "$script"
}

export_agent_env() {
  agent_env_resolve
  materialize_mcp >/dev/null 2>&1 || true
  agent_env_export_runtime_paths

  local key
  for key in DEV_IDE_API_TOKEN DEVIDE_WORKSPACE_ID DEVIDE_WORKSPACE_NAME \
    DEVIDE_TERMINAL_MCP_URL DEVIDE_PREVIEW_MCP_URL DEVIDE_CHECKOUT \
    DEVIDE_AGENT_MCP_HOME DEVIDE_SCRIPTS DEVIDE_AGENT_ENV_FILE \
    CLAUDE_CONFIG_DIR CODEX_HOME PATH; do
    if [[ -n "${!key:-}" ]]; then
      printf 'export %s=%q\n' "$key" "${!key}"
    fi
  done

  if [[ -z "${DEVIDE_SCRIPTS:-}" ]]; then
    printf 'export DEVIDE_SCRIPTS=%q\n' "${DEVIDE_ROOT}/scripts"
  fi
}

agent_auth() {
  local sub="${1:-}"
  shift || true

  case "$sub" in
    signin)
      local script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/lib/agent-auth-login.sh"
      if [[ ! -f "$script" ]]; then
        script="${DEVIDE_ROOT}/scripts/lib/agent-auth-login.sh"
      fi

      local owner="" runtime="" profile_script workspace
      profile_script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/lib/agent-auth-profile.sh"
      if [[ ! -f "$profile_script" ]]; then
        profile_script="${DEVIDE_ROOT}/scripts/lib/agent-auth-profile.sh"
      fi

      case "${1:-}" in
        claude|codex)
          runtime="$1"
          shift || true

          if ! agent_env_resolve >/dev/null 2>&1; then
            echo "error: could not detect owner; run inside a DevIDE workspace or use: devide agent auth signin <owner> <claude|codex>" >&2
            exit 64
          fi

          workspace="${DEVIDE_WORKSPACE_NAME:-${DEVIDE_WORKSPACE_ID:-}}"
          # shellcheck source=lib/agent-auth-profile.sh
          source "$profile_script"
          owner="$(agent_auth_profile_owner_slug "$workspace" 2>/dev/null || true)"
          if [[ -z "$owner" ]]; then
            echo "error: could not derive owner from workspace: ${workspace}" >&2
            exit 64
          fi
          echo "signing ${runtime} into owner profile: ${owner} (${workspace})" >&2
          ;;
        "")
          echo "usage: devide agent auth signin <claude|codex>  # inside a DevIDE workspace" >&2
          echo "   or: devide agent auth signin <owner> <claude|codex>" >&2
          exit 64
          ;;
        *)
          if [[ -z "${2:-}" ]]; then
            echo "usage: devide agent auth signin <claude|codex>  # inside a DevIDE workspace" >&2
            echo "   or: devide agent auth signin <owner> <claude|codex>" >&2
            exit 64
          fi
          owner="$1"
          runtime="$2"
          shift 2
          ;;
      esac

      bash "$script" "$owner" "$runtime" "$@"
      ;;
    status)
      local script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/lib/agent-auth-profile.sh"
      if [[ ! -f "$script" ]]; then
        script="${DEVIDE_ROOT}/scripts/lib/agent-auth-profile.sh"
      fi

      local workspace="${1:-}"
      if [[ -n "$workspace" ]]; then
        shift || true
      else
        if ! agent_env_resolve >/dev/null 2>&1; then
          echo "error: missing workspace (or run inside a DevIDE agent environment)" >&2
          exit 64
        fi
        workspace="${DEVIDE_WORKSPACE_NAME:-${DEVIDE_WORKSPACE_ID:-}}"
      fi

      if [[ -z "$workspace" ]]; then
        echo "error: missing workspace" >&2
        exit 64
      fi

      bash "$script" --status "$workspace" "$@"
      ;;
    list)
      local script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/lib/agent-auth-profile.sh"
      if [[ ! -f "$script" ]]; then
        script="${DEVIDE_ROOT}/scripts/lib/agent-auth-profile.sh"
      fi
      bash "$script" --list
      ;;
    -h|--help|help|"")
      echo "usage: devide agent auth <signin|status|list> ..." >&2
      ;;
    *)
      echo "error: unknown agent auth subcommand: $sub" >&2
      exit 1
      ;;
  esac
}

agent_doctor() {
  local script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/lib/agent-doctor.sh"
  if [[ ! -f "$script" ]]; then
    script="${DEVIDE_ROOT}/scripts/lib/agent-doctor.sh"
  fi
  bash "$script" "$@"
}

ensure_terminal_tool() {
  local tool="${1:-}"
  if [[ -z "$tool" ]]; then
    echo "error: missing tool name" >&2
    usage >&2
    exit 64
  fi

  local script="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/ensure-terminal-tool.sh"
  if [[ ! -f "$script" ]]; then
    script="${DEVIDE_ROOT}/scripts/ensure-terminal-tool.sh"
  fi

  bash "$script" "$@"
}

launch_agent() {
  local runtime="${1:-}"
  shift || true

  if [[ -z "$runtime" ]]; then
    echo "error: missing runtime (grok|codex|claude|opencode|agent|...)" >&2
    exit 1
  fi

  agent_env_resolve
  materialize_mcp >/dev/null
  agent_env_export_runtime_paths

  local launcher="${DEVIDE_SCRIPTS:-${DEVIDE_ROOT}/scripts}/launch-devide-agent.sh"
  if [[ ! -f "$launcher" ]]; then
    launcher="${DEVIDE_ROOT}/scripts/launch-devide-agent.sh"
  fi

  case "$runtime" in
    grok|codex|claude|opencode|agent)
      exec bash "$launcher" "$runtime" "$@"
      ;;
    *)
      local bin
      bin="$(real_agent_bin "$runtime")"
      if [[ -z "$bin" ]]; then
        echo "error: could not find executable for ${runtime}" >&2
        exit 1
      fi
      exec "$bin" "$@"
      ;;
  esac
}

main() {
  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    agent)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        launch) launch_agent "$@" ;;
        env) export_agent_env ;;
        auth) agent_auth "$@" ;;
        doctor) agent_doctor "$@" ;;
        -h|--help|help|"") usage ;;
        *) echo "error: unknown agent subcommand: $sub" >&2; usage >&2; exit 1 ;;
      esac
      ;;
    mcp)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        ensure) materialize_mcp ;;
        -h|--help|help|"") usage ;;
        *) echo "error: unknown mcp subcommand: $sub" >&2; usage >&2; exit 1 ;;
      esac
      ;;
    tools)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        ensure) ensure_terminal_tool "$@" ;;
        -h|--help|help|"") usage ;;
        *) echo "error: unknown tools subcommand: $sub" >&2; usage >&2; exit 1 ;;
      esac
      ;;
    ensure-installed)
      ensure_terminal_tool "$@"
      ;;
    -h|--help|help|"") usage ;;
    *)
      echo "error: unknown command: $cmd" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
