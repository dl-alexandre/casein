{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casein.dev/schemas/windows-physical-device-lab-evidence-v1.json",
  "title": "Casein Windows-origin physical iPad/Android lab evidence",
  "description": "Fixed-schema operator evidence for issue #377. Simulators, emulators, and Linux-only self-checks must not set physical_* claims or verdict matrix_passed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "issue",
    "recorded_at_utc",
    "product_revision",
    "claims",
    "verdict"
  ],
  "properties": {
    "schema": {
      "const": "casein_windows_physical_device_lab"
    },
    "schema_version": {
      "const": 1
    },
    "issue": {
      "const": 377
    },
    "recorded_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "product_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "operator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_android",
        "physical_ipad",
        "windows_origin_exercised",
        "simulator_or_emulator",
        "secrets_redacted"
      ],
      "properties": {
        "physical_android": { "type": "boolean" },
        "physical_ipad": { "type": "boolean" },
        "windows_origin_exercised": { "type": "boolean" },
        "simulator_or_emulator": { "type": "boolean" },
        "secrets_redacted": { "type": "boolean" }
      }
    },
    "windows_host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string", "maxLength": 64 },
        "package_signed": { "type": "boolean" },
        "origin_id_prefix": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "display_name_suffix_ok": { "type": "boolean" },
        "trusted_lan": {
          "enum": ["private_rfc1918", "none", "not_applicable"]
        },
        "profiles_collision_free": { "type": "boolean" }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "android": { "$ref": "#/$defs/platform" },
        "ipad": { "$ref": "#/$defs/platform" }
      }
    },
    "attachments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenshot_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "log_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:/-]{1,256}$"
          }
        },
        "issue_comment_urls": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^https://github\\.com/dl-alexandre/casein/issues/377#issuecomment-[0-9]+$"
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "matrix_passed",
        "matrix_failed",
        "lab_incomplete",
        "lab_unreachable_on_this_host",
        "rejected_secrets_or_schema"
      ]
    },
    "host_probe": {
      "type": "object",
      "additionalProperties": false,
      "description": "Filled only by --self-check; never implies physical pass.",
      "properties": {
        "uname": { "type": "string", "maxLength": 128 },
        "adb_present": { "type": "boolean" },
        "adb_device_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "idevice_id_present": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 512 }
      }
    }
  },
  "$defs": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_label", "rows"],
      "properties": {
        "device_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "os_version": { "type": "string", "maxLength": 64 },
        "app_version": { "type": "string", "maxLength": 64 },
        "rows": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial_pair",
            "warm_resume_followup",
            "background_foreground",
            "killed_cold_cached",
            "host_restart",
            "device_restart",
            "offline_firewall_denied",
            "vpn_interface_change_repair",
            "tampered_target_fail_closed",
            "operator_verify_fail_closed",
            "pwa_escalation"
          ],
          "properties": {
            "initial_pair": { "$ref": "#/$defs/row" },
            "warm_resume_followup": { "$ref": "#/$defs/row" },
            "background_foreground": { "$ref": "#/$defs/row" },
            "killed_cold_cached": { "$ref": "#/$defs/row" },
            "host_restart": { "$ref": "#/$defs/row" },
            "device_restart": { "$ref": "#/$defs/row" },
            "offline_firewall_denied": { "$ref": "#/$defs/row" },
            "vpn_interface_change_repair": { "$ref": "#/$defs/row" },
            "tampered_target_fail_closed": { "$ref": "#/$defs/row" },
            "operator_verify_fail_closed": { "$ref": "#/$defs/row" },
            "pwa_escalation": { "$ref": "#/$defs/row" }
          }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "enum": ["passed", "failed", "skipped", "not_run"]
        },
        "at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "notes": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  }
}
