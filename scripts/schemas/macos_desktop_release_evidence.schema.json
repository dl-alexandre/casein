{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casein.dev/schemas/macos-desktop-release-evidence-v1.json",
  "title": "Casein macOS desktop release evidence (#382)",
  "description": "Operator evidence for Developer ID sign + notarize/staple + clean-Mac lifecycle. Linux/devbox dry-runs must keep claims.developer_id, notarized, stapled, signed_lifecycle, and passed_release false and list missing[] explicitly. Does not depend on actions/upload-artifact.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "kind",
    "issue",
    "started_at_utc",
    "completed_at_utc",
    "result",
    "git",
    "host",
    "app",
    "archive",
    "phases",
    "notes"
  ],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "macos_desktop_release_evidence" },
    "issue": { "const": 382 },
    "started_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "completed_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "result": {
      "type": "string",
      "enum": [
        "passed_release",
        "signed_unnotarized",
        "adhoc_smoke_only",
        "blocked",
        "failed",
        "incomplete",
        "running"
      ]
    },
    "error": { "type": "string" },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "developer_id",
          "notary_profile",
          "signed_lifecycle",
          "app_bundle",
          "archive",
          "darwin_host",
          "codesign_tools"
        ]
      },
      "uniqueItems": true
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "developer_id": { "type": "boolean" },
        "notarized": { "type": "boolean" },
        "stapled": { "type": "boolean" },
        "signed_lifecycle": { "type": "boolean" },
        "passed_release": { "type": "boolean" }
      }
    },
    "fixture_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "developer_id": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9._-]{1,128}$"
        },
        "notary_profile": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9._-]{1,128}$"
        },
        "signed_lifecycle": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9._-]{1,128}$"
        }
      }
    },
    "staging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_path": { "type": "string" },
        "receipt_mode": {
          "type": "string",
          "enum": ["skip", "stage-only", "upload", "unknown", ""]
        },
        "upload_attempted": { "type": "boolean" },
        "upload_succeeded": { "type": "boolean" }
      }
    },
    "git": {
      "type": "object",
      "required": ["revision", "describe"],
      "properties": {
        "revision": { "type": "string" },
        "describe": { "type": "string" },
        "github_sha": { "type": "string" }
      }
    },
    "host": {
      "type": "object",
      "required": ["os", "arch"],
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "release": { "type": "string" },
        "runner_name": { "type": "string" },
        "runner_os": { "type": "string" },
        "runner_arch": { "type": "string" },
        "github_run_id": { "type": "string" }
      }
    },
    "app": {
      "type": "object",
      "required": [
        "path",
        "exists",
        "signature_kind",
        "signer_authority",
        "team_identifier",
        "hardened_runtime",
        "codesign_verify",
        "spctl",
        "stapler"
      ],
      "properties": {
        "path": { "type": "string" },
        "exists": { "type": "boolean" },
        "bundle_identifier": { "type": "string" },
        "signature_kind": {
          "type": "string",
          "enum": ["missing", "adhoc", "developer_id", "other"]
        },
        "signer_authority": { "type": "string" },
        "team_identifier": { "type": "string" },
        "codesign_flags": { "type": "string" },
        "hardened_runtime": { "type": "boolean" },
        "codesign_verify": { "type": "string" },
        "spctl": { "type": "string" },
        "stapler": { "type": "string" }
      }
    },
    "archive": {
      "type": "object",
      "required": ["path", "exists", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string" },
        "exists": { "type": "boolean" },
        "sha256": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "phases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "result": { "const": "passed_release" } }
      },
      "then": {
        "properties": {
          "missing": {
            "type": "array",
            "maxItems": 0
          },
          "app": {
            "properties": {
              "signature_kind": { "const": "developer_id" },
              "hardened_runtime": { "const": true },
              "spctl": { "const": "accepted" },
              "stapler": { "const": "valid" },
              "codesign_verify": { "const": "passed" }
            }
          },
          "archive": {
            "properties": {
              "exists": { "const": true },
              "sha256": { "type": "string", "minLength": 64 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "incomplete",
              "blocked",
              "failed",
              "adhoc_smoke_only",
              "signed_unnotarized",
              "running"
            ]
          }
        }
      },
      "then": {
        "required": ["missing"],
        "properties": {
          "missing": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
