[Unit]
Description=Casein agent-worktree cleanup (remove idle+clean+pushed worktrees)
Wants=casein-loopback.service
After=casein-loopback.service

[Service]
Type=oneshot
User=__USER__
EnvironmentFile=-/etc/casein/devide.env
# The installer fills the args below: empty for a dry-run (log-only) install, or
# --apply for the deleting install. The script itself refuses to delete if it
# cannot reach tmux to verify which worktrees are live.
ExecStart=__CHECKOUT__/scripts/cleanup-agent-worktrees.sh __CLEANUP_ARGS__
