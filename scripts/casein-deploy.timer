# Fires casein-deploy.service ~every 2 minutes to poll origin/master and
# auto-deploy when it advances. Self-hosted stand-in for the GitHub Actions
# push-triggered deploy while Actions is billing-blocked.
#
# Install / enable via: bash scripts/ensure-casein-deploy-poller.sh

[Unit]
Description=Poll origin/master and auto-deploy DevIDE (self-hosted CI deploy)

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
# Catch up on a tick missed while the box was off, but don't stampede.
Persistent=true

[Install]
WantedBy=timers.target
