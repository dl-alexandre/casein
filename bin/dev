#!/usr/bin/env bash
#
# bin/dev - Development environment manager for dev_ide
#
# This script manages the local development stack using tmux sessions
# so everything stays running even if you close your terminal.
#
# Usage:
#   bin/dev up          Start everything (recommended)
#   bin/dev down        Stop everything
#   bin/dev logs        View Phoenix logs (Ctrl+B then D to detach)
#   bin/dev logs mock   View mock manager logs
#   bin/dev status      Show what's currently running
#   bin/dev restart     Restart the whole stack
#   bin/dev open        Print the correct URL to open in the browser
#   bin/dev doctor      Check if your dev environment is set up correctly
#   bin/dev iex         Open an IEx shell connected to the running app
#

set -e

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DB_URL="ecto://postgres:postgres@localhost:5433/dev_ide_dev"
WORKSPACE_DIR="/tmp/casein_workspaces/alpha"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m' # No Color

log() {
  echo -e "${BLUE}[dev]${NC} $1"
}

success() {
  echo -e "${GREEN}[dev]${NC} $1"
}

warn() {
  echo -e "${YELLOW}[dev]${NC} $1"
}

error() {
  echo -e "${RED}[dev]${NC} $1"
}

ensure_workspace_dir() {
  if [ ! -d "$WORKSPACE_DIR" ]; then
    log "Creating workspace directory..."
    mkdir -p "$WORKSPACE_DIR"
  fi
}

case "$1" in
  up)
    log "Starting dev environment..."

    ensure_workspace_dir

    # Start Postgres
    if ! docker ps --filter "name=dev_ide_pg" --format '{{.Names}}' | grep -q dev_ide_pg; then
      log "Starting Postgres container..."
      docker start dev_ide_pg 2>/dev/null || \
        docker run --rm -d --name dev_ide_pg \
          -e POSTGRES_USER=postgres \
          -e POSTGRES_PASSWORD=postgres \
          -e POSTGRES_DB=dev_ide_dev \
          -p 5433:5432 \
          postgres:16-alpine
    fi

    # Wait for Postgres
    log "Waiting for Postgres to be ready..."
    until docker exec dev_ide_pg pg_isready -U postgres -d dev_ide_dev >/dev/null 2>&1; do sleep 1; done
    success "Postgres is ready"

    # Start mock manager in tmux (if not running)
    if ! tmux has-session -t mock_manager 2>/dev/null; then
      log "Starting mock manager in tmux session 'mock_manager'..."
      tmux new-session -d -s mock_manager "python3 $PROJECT_DIR/docker/mock_manager/server.py"
    else
      warn "mock_manager tmux session already exists"
    fi

    # Start Phoenix in tmux (if not running)
    if ! tmux has-session -t phoenix 2>/dev/null; then
      log "Starting Phoenix in tmux session 'phoenix'..."
      tmux new-session -d -s phoenix \
        "export DATABASE_URL='$DB_URL' && cd $PROJECT_DIR && mix phx.server"
    else
      warn "phoenix tmux session already exists"
    fi

    echo ""
    success "Dev environment is up!"
    echo ""
    echo "Useful commands:"
    echo "  ./bin/dev logs        → View Phoenix logs"
    echo "  ./bin/dev status      → Check running services"
    echo "  ./bin/dev open        → Get the browser URL"
    echo ""
    echo "Next step:"
    echo "  1. Run: ./bin/dev logs"
    echo "  2. Open the URL from: ./bin/dev open"
    echo "  3. Go to Terminal tab → click 'Raw shell (Ghostty)'"
    ;;

  down)
    log "Stopping dev environment..."
    tmux kill-session -t phoenix 2>/dev/null || true
    tmux kill-session -t mock_manager 2>/dev/null || true
    docker stop dev_ide_pg 2>/dev/null || true
    success "Everything stopped."
    ;;

  logs)
    session="${2:-phoenix}"
    if tmux has-session -t "$session" 2>/dev/null; then
      log "Attaching to '$session' session (Ctrl+B then D to detach)..."
      tmux attach -t "$session"
    else
      error "Session '$session' is not running."
      echo "Available sessions:"
      tmux ls 2>/dev/null || echo "  (none)"
      echo ""
      echo "Try: ./bin/dev up"
    fi
    ;;

  status)
    echo "=== tmux sessions ==="
    if tmux ls 2>/dev/null; then
      :
    else
      echo "  (none running)"
    fi
    echo ""
    echo "=== Docker ==="
    docker ps --filter "name=dev_ide_pg" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || echo "  No dev_ide_pg container"
    ;;

  restart)
    $0 down
    sleep 2
    $0 up
    ;;

  open)
    echo ""
    echo "Open this URL in your browser:"
    echo "  http://localhost:4000/workspaces/alpha"
    echo ""
    echo "Then go to the Terminal tab and click 'Raw shell (Ghostty)'."
    ;;

  doctor)
    echo "=== Dev Environment Doctor ==="
    echo ""

    # Check directory
    if [ -d "$WORKSPACE_DIR" ]; then
      success "Workspace directory exists: $WORKSPACE_DIR"
    else
      warn "Workspace directory missing. Will be created on 'up'."
    fi

    # Check config
    if grep -q "raw_terminal_backend.*ghostty" "$PROJECT_DIR/config/dev.exs"; then
      success "raw_terminal_backend is set to :ghostty"
    else
      error "raw_terminal_backend is NOT set to :ghostty in config/dev.exs"
    fi

    # Check if Tidewave is configured
    if grep -q "tidewave" "$PROJECT_DIR/config/dev.exs" 2>/dev/null || grep -q "domain_base" "$PROJECT_DIR/docker/mock_manager/server.py" 2>/dev/null; then
      success "Tidewave should be detectable (mock has domain_base)"
    else
      warn "Tidewave may not be detected. Check mock manager."
    fi

    echo ""
    echo "Run './bin/dev up' to start everything."
    ;;

  iex)
    if tmux has-session -t phoenix 2>/dev/null; then
      log "Opening IEx shell attached to the running Phoenix app..."
      export DATABASE_URL="$DB_URL"
      iex -S mix
    else
      error "Phoenix is not running. Start it first with: ./bin/dev up"
    fi
    ;;

  *)
    echo "dev_ide development helper"
    echo ""
    echo "Usage: bin/dev <command>"
    echo ""
    echo "Commands:"
    echo "  up          Start the full dev stack (Phoenix + mock manager)"
    echo "  down        Stop everything"
    echo "  logs        Attach to Phoenix logs (or 'logs mock')"
    echo "  status      Show running services"
    echo "  restart     Restart the stack"
    echo "  open        Print the browser URL you should use"
    echo "  doctor      Check if your environment is set up correctly"
    echo "  iex         Open an IEx shell connected to the running app"
    exit 1
    ;;
esac
