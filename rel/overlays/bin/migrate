#!/bin/sh
# Run pending Ecto migrations against the configured repo.
#
# Invoked as a one-shot before rolling the server pool:
#   docker run --rm dev_ide:latest /app/bin/migrate
#
# Implemented as `eval` against DevIDE.Release.migrate/0
# (see audit_remote.md CC-1 and lib/dev_ide/release.ex).

set -eu

cd -P -- "$(dirname -- "$0")/.."

if [ "${DATABASE_PATH:-}" != "" ]; then
  mkdir -p "$(dirname -- "${DATABASE_PATH}")"
  touch "${DATABASE_PATH}"
fi

exec ./bin/dev_ide eval "DevIDE.Release.migrate()"
