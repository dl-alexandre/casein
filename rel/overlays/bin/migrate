#!/bin/sh
# Run pending Ecto migrations against the configured repo.
#
# Invoked as a one-shot before rolling the server pool:
#   docker run --rm casein:latest /app/bin/migrate
#
# Implemented as `eval` against Casein.Release.migrate/0
# (see audit_remote.md CC-1 and lib/casein/release.ex).

set -eu

cd -P -- "$(dirname -- "$0")/.."

if [ "${DATABASE_PATH:-}" != "" ]; then
  mkdir -p "$(dirname -- "${DATABASE_PATH}")"
  touch "${DATABASE_PATH}"
fi

exec ./bin/casein-runtime eval "Casein.Release.migrate()"
