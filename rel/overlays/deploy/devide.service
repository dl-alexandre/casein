# DevIDE-on-devbox systemd unit (stable layout + activation documented in
# /opt/devide/deploy/README.md — the authoritative runbook after the 7204683
# reconciliation).
#
# Mirrors the milc-devbox manager's deployment shape: a host process in the
# `docker` group, not a container. A host process has native access to
# /data/workspaces and the docker socket, so containerizing buys nothing here
# (the docker-socket mount would be root-equivalent anyway).
#
# Install / update (after activation step that populates the stable layout):
#   sudo cp /opt/devide/deploy/devide.service /etc/systemd/system/devide.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now devide
#
# Canonical source: lib/dev_ide/integrations/manager/deploy/ in the dev_ide
# repo. Releases ship these files at <release-root>/deploy/ via build-time
# copies in rel/overlays/deploy/ (scripts/check-deploy-sync.sh, wired into
# mix precommit, enforces that the two copies stay byte-identical — symlinks
# can't be used because docker cp, which scripts/build-release.sh relies on
# to extract the release tree, does not dereference them). An explicit
# activation step (documented in the README) then copies them into the
# *stable* /opt/devide/deploy/ location.
# This makes the paths in this unit file (and in ExecStartPre) independent of
# any particular release tree or git checkout, so `git pull` + release swaps
# (cd0aed5, 4c308b8 Ghostty, etc.) never break the unit.
#
# The ExecStartPre for the compose file always points at the stable location
# after activation. The release binaries (migrate, dev_ide) remain under
# /opt/devide/release/ and can be swapped/rolled back independently.
#
# See /opt/devide/deploy/README.md (or the canonical copy in the repo) for the
# full host layout, activation commands, and reconciliation history.

[Unit]
Description=DevIDE — shared on-devbox IDE
Documentation=https://github.com/dl-alexandre/dev_ide/blob/master/lib/dev_ide/integrations/manager/deploy/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

# A bad env file or a failed migration makes an ExecStartPre fail; without a
# start limit, Restart=always would loop every RestartSec forever and hammer
# docker. Give up after 5 failures in 60s so a misconfig surfaces as a
# `failed` unit you can read in `journalctl`, not an infinite loop.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=devbox
Group=docker
EnvironmentFile=/etc/devide/devide.env
WorkingDirectory=/opt/devide

# Bring up (and wait for healthy) the dedicated Postgres container (from the
# *stable* deploy artifacts), then run pending migrations against it — before
# the release boots.
ExecStartPre=/usr/bin/docker compose -f /opt/devide/deploy/docker-compose.postgres.yml --env-file /etc/devide/devide.env up -d --wait
ExecStartPre=/opt/devide/release/bin/migrate
ExecStart=/opt/devide/release/bin/dev_ide start
ExecStop=/opt/devide/release/bin/dev_ide stop

# Keep daemonized tmux servers alive across release restarts. In host-tmux
# mode the `devide_*` tmux server is spawned by the BEAM and stays in this
# unit's cgroup even after it daemonizes; the default KillMode=control-group
# would SIGTERM the whole cgroup on every `systemctl restart` — i.e. on every
# deploy — destroying all live terminal sessions. KillMode=process stops only
# the BEAM (ExecStop drains it gracefully and erlexec reaps its own attach
# clients), leaving the tmux server up so reconnecting Session processes
# re-attach via `tmux new-session -A` with scrollback intact. Harmless in
# container-tmux mode, where the server already lives in the workspace
# container's own (docker-managed) cgroup, not this unit's.
KillMode=process

# First boot pulls the postgres image and waits for it to report healthy
# (up to ~100s of healthcheck budget) before migrate + release boot — well
# past systemd's 90s default. 5 minutes covers a cold start on a slow link.
TimeoutStartSec=300

Restart=always
RestartSec=3

# Hardening — DevIDE needs the docker socket and /data/workspaces, but nothing
# else writable outside its own tree.
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/data/workspaces /opt/devide

[Install]
WantedBy=multi-user.target
