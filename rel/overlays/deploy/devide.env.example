# DevIDE-on-devbox environment (stable layout + activation documented in
# /opt/devide/deploy/README.md and devide.service).
#
# Copy to /etc/devide/devide.env, fill in the blanks, `chmod 600`. Consumed by
# both devide.service (systemd EnvironmentFile) and docker-compose.postgres.yml
# (--env-file). Generate secrets with: mix phx.gen.secret

# --- Phoenix -----------------------------------------------------------------
PHX_SERVER=true
PHX_HOST=devide.devbox.milcgroup.com
PORT=4000
# Trust boundary: DevIDE trusts the X-Auth-Request-* headers Caddy sets, so it
# MUST be unreachable except through Caddy. Bind loopback.
PHX_IP=127.0.0.1
SECRET_KEY_BASE=

# Pinned Erlang distribution cookie. REQUIRED for a stable deploy: without it
# the release auto-generates a fresh cookie at every boot and writes it to
# releases/COOKIE, so the running node's cookie diverges from the on-disk file.
# Peer commands (`bin/dev_ide stop`, `rpc`, health probes) then fail the
# distribution challenge with "Invalid challenge reply" / :noconnection — the
# graceful ExecStop fails and every deploy hard-SIGTERMs the node mid-session,
# draining LiveView sockets and killing live tmux terminals. deploy-devbox-release.sh
# auto-generates this if missing; set it explicitly to keep it stable across
# env-file regens. Generate with: mix phx.gen.secret
RELEASE_COOKIE=

# --- Database (dedicated Postgres container) ---------------------------------
# DEVIDE_PG_* feed docker-compose.postgres.yml (they create the role + DB).
# DATABASE_URL is what DevIDE itself connects with — it MUST encode the same
# user / password / db. Keep them in sync by hand: a mismatch means the
# container starts fine but DevIDE can't authenticate, and the unit fails.
#
# Use a URL-safe password (letters + digits). Characters like @ : / # break
# DATABASE_URL parsing. `mix phx.gen.secret` output is URL-safe.
DEVIDE_PG_USER=dev_ide
DEVIDE_PG_PASSWORD=
DEVIDE_PG_DB=dev_ide_prod
DATABASE_URL=ecto://dev_ide:CHANGEME@127.0.0.1:15432/dev_ide_prod

# --- milc-devbox manager -----------------------------------------------------
# Manager is colocated on the devbox host — no SSH tunnel.
MILC_DEVBOX_MANAGER_URL=http://127.0.0.1:9000
DEV_IDE_API_TOKEN=

# --- Deploy webhook (optional, push-triggered poller) ------------------------
# When set, POST /api/deploy_webhook accepts GitHub push webhooks signed with
# this secret and runs `sudo -n systemctl start devide-deploy.service`.
# The 2-minute devide-deploy.timer remains the fallback heartbeat.
# Generate with: mix phx.gen.secret
# DEVIDE_DEPLOY_WEBHOOK_SECRET=
# Optional guard against unexpected repositories (defaults to dl-alexandre/dev_ide).
# DEVIDE_GITHUB_REPO=dl-alexandre/dev_ide

# --- Agent worktree runtime reaper -------------------------------------------
# Expires stale agent-worktree runtimes and removes clean idle worktrees so the
# pane picker does not grow without bound. Enabled by default in prod releases.
# DEVIDE_RUNTIME_REAPER_ENABLED=0
# DEVIDE_RUNTIME_REAPER_DRY_RUN=1
# DEVIDE_RUNTIME_REAPER_TTL_SECONDS=21600
# DEVIDE_RUNTIME_REAPER_SWEEP_INTERVAL_MS=3600000

# --- On-devbox execution substrate (§4) --------------------------------------
# Workspaces are local under /data/workspaces; commands/terminals hop into the
# workspace app container via `docker compose exec`.
DEV_IDE_ON_DEVBOX=true
DEV_IDE_DEVBOX_EXEC_SERVICE=onebackend-v3
# Leave unset (or false) so tmux runs inside each workspace container when
# available. DEV_IDE_TMUX_HOST_SHELL=true forces a single shared host tmux
# server for every user — avoid on multi-user devboxes.
# DEV_IDE_TMUX_HOST_SHELL=false

# --- Identity & scoping (§2/§3) ----------------------------------------------
# Trust X-Auth-Request-Email from Caddy + oauth2-proxy.
DEV_IDE_FORWARD_AUTH=true
# Comma/space separated. These emails get cross-user workspace visibility,
# mirroring the manager's auth-config.json `admins` list.
DEV_IDE_ADMINS=tramzel@milcgroup.com
# Derive preview MCP forward-auth headers from workspace.user@this-domain.
DEV_IDE_FORWARD_AUTH_EMAIL_DOMAIN=milcgroup.com
# Optional last-resort static email for machine-only manager calls without a
# LiveView viewer (background jobs). Prefer forwarding the real viewer email.
# DEV_IDE_DEVBOX_USER_EMAIL=

# --- Preview MCP browser automation -----------------------------------------
# memory keeps discovery/open/observe working through HTTP-only observation.
# playwright enables click/type/press/screenshot through the bundled Node helper.
DEV_IDE_PREVIEW_CONTROL_ADAPTER=playwright
# Optional override. Relative paths resolve from the release app priv directory.
# DEV_IDE_PREVIEW_PLAYWRIGHT_SCRIPT=scripts/preview_playwright.mjs
# Stable screenshot location; the service has write access to /opt/devide.
DEV_IDE_PREVIEW_ARTIFACTS_ROOT=/opt/devide/preview_artifacts
# Stable generated artifact-project worktrees. Runtime registration
# automatically accepts this root when configured.
DEV_IDE_ARTIFACT_PROJECTS_ROOT=/opt/devide/artifact_projects
# Dedicated, isolated origin for PR-shareable artifact reports (stronger
# isolation than serving workspace-authored HTML on the cockpit origin). The
# manager routes this subdomain through the same oauth2-proxy forward_auth to
# DevIDE (milc-devbox artifacts.<domain> block). When set, artifact public_urls
# are built from it; unset → artifacts stay on the cockpit origin. Keep this
# uncommented so an env rebuild from this template doesn't silently drop it.
DEVIDE_ARTIFACT_URL=https://artifacts.devbox.milcgroup.com
# Preview MCP derives forward-auth headers from the workspace owner when agents
# omit default_headers. Override only for non-workspace-scoped preview paths:
# DEV_IDE_PREVIEW_FORWARD_AUTH_EMAIL=ops@example.com
# DEV_IDE_PREVIEW_DEFAULT_HEADERS={"X-Auth-Request-Email":"ops@example.com"}

# --- Push notifications (APNs/FCM) -------------------------------------------
# OS push to the devide_mob companion. Unset = LogProvider (push inert). Set
# `native` to route per-platform: Android→FCM, iOS→APNs. See
# docs/subsystems/push_notifications.md. Verify with `mix dev_ide.push.check`.
# DEV_IDE_PUSH_PROVIDER=native
#
# iOS / APNs. TOPIC must equal the signed app bundle id, ENV must match the
# build's aps-environment entitlement (development build → sandbox). The .p8
# auth key is a file on the host (chmod 600, root/devbox-owned); do NOT inline
# it here — env files can't hold its multiline PEM.
# DEV_IDE_APNS_TEAM_ID=
# DEV_IDE_APNS_KEY_ID=
# DEV_IDE_APNS_TOPIC=com.alexandrefamilyfarm.devide-mob
# DEV_IDE_APNS_PRIVATE_KEY_PATH=/etc/devide/apns-auth-key.p8
# DEV_IDE_APNS_ENV=sandbox
#
# Android / FCM. Point at a Firebase service-account JSON (chmod 600).
# DEV_IDE_FCM_SERVICE_ACCOUNT_PATH=/etc/devide/firebase-service-account.json
