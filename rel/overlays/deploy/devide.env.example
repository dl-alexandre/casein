# DevIDE-on-devbox environment (stable layout + activation documented in
# /opt/devide/deploy/README.md and devide.service).
#
# Copy to /etc/devide/devide.env, fill in the blanks, `chmod 600`. Consumed by
# both devide.service (systemd EnvironmentFile) and docker-compose.postgres.yml
# (--env-file). Generate secrets with: mix phx.gen.secret

# --- Phoenix -----------------------------------------------------------------
PHX_SERVER=true
PHX_HOST=devide.devbox.milcgroup.com
PORT=4000
# Trust boundary: DevIDE trusts the X-Auth-Request-* headers Caddy sets, so it
# MUST be unreachable except through Caddy. Bind loopback.
PHX_IP=127.0.0.1
SECRET_KEY_BASE=

# --- Database (dedicated Postgres container) ---------------------------------
# DEVIDE_PG_* feed docker-compose.postgres.yml (they create the role + DB).
# DATABASE_URL is what DevIDE itself connects with — it MUST encode the same
# user / password / db. Keep them in sync by hand: a mismatch means the
# container starts fine but DevIDE can't authenticate, and the unit fails.
#
# Use a URL-safe password (letters + digits). Characters like @ : / # break
# DATABASE_URL parsing. `mix phx.gen.secret` output is URL-safe.
DEVIDE_PG_USER=dev_ide
DEVIDE_PG_PASSWORD=
DEVIDE_PG_DB=dev_ide_prod
DATABASE_URL=ecto://dev_ide:CHANGEME@127.0.0.1:15432/dev_ide_prod

# --- milc-devbox manager -----------------------------------------------------
# Manager is colocated on the devbox host — no SSH tunnel.
MILC_DEVBOX_MANAGER_URL=http://127.0.0.1:9000
DEV_IDE_API_TOKEN=

# --- On-devbox execution substrate (§4) --------------------------------------
# Workspaces are local under /data/workspaces; commands/terminals hop into the
# workspace app container via `docker compose exec`.
DEV_IDE_ON_DEVBOX=true
DEV_IDE_DEVBOX_EXEC_SERVICE=onebackend-v3

# --- Identity & scoping (§2/§3) ----------------------------------------------
# Trust X-Auth-Request-Email from Caddy + oauth2-proxy.
DEV_IDE_FORWARD_AUTH=true
# Comma/space separated. These emails get cross-user workspace visibility,
# mirroring the manager's auth-config.json `admins` list.
DEV_IDE_ADMINS=tramzel@milcgroup.com
# Optional: forward-auth email for non-LiveView manager calls (machine paths).
# DEV_IDE_DEVBOX_USER_EMAIL=
