# Mix / Erlang build artifacts
_build/
deps/
*.beam
*.ez
erl_crash.dump

# Node / asset build artifacts
assets/node_modules/
priv/static/assets/
priv/static/cache_manifest.json

# Editor / OS noise
.elixir_ls/
.lexical/
.DS_Store

# Local dev state
.envrc
.env
.env.*
cover/
tmp/
release-out/

# UI iteration studies — design history, not shipped
ui-iterations/
ui-iterations-v2/
ui-iterations-v3/

# docs/ is needed at release-assemble time — mix.exs `copy_release_docs/1`
# copies it into the release tree. Keep it in the build context.

# Git metadata (release image doesn't need git)
.git/
.gitignore
.github/

# Dockerfile and friends shouldn't ship inside the image
Dockerfile
.dockerignore
