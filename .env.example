# Casein local docker-compose stack — copy to .env and fill in.
#
#   cp .env.example .env
#   docker compose up
#
# The .env file is gitignored. Secrets stay on disk, not in version control.

# ---- Required ----

# Cookie/token signing key. Generate with: mix phx.gen.secret
# (or: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY_BASE=replace-me-with-a-real-64-char-secret

# Bearer token the HTTP API requires.
# Generate with: mix phx.gen.secret
CASEIN_API_TOKEN=replace-me-with-a-real-bearer-token

# Bearer token accepted only by fleet runner transport routes.
# Use a different value from CASEIN_API_TOKEN for real dogfood/release runs.
CASEIN_RUNNER_TOKEN=replace-me-with-a-real-runner-token

# The hostname the operator's browser uses to reach Casein.
# For a pure local stack this is localhost; for a real remote
# deploy this is your public domain.
PHX_HOST=localhost

# Generic container runtime with no devbox operator integrations.
CASEIN_PROFILE=portable

# ---- Optional ----

# Path inside the Casein container that workspaces live under.
# Compose bind-mounts ./workspaces-local/ to this path.
CASEIN_WORKSPACES_ROOT=/workspaces

# Optional data-only operator overlay. This file owns deployment-specific
# capabilities and values such as the deploy repository, service name, socket
# status path, and reverse-proxy health integration. See config/operator.example.json.
# CASEIN_OPERATOR_CONFIG_FILE=/etc/casein/operator.json

# Path on the Docker host mounted at CASEIN_WORKSPACES_ROOT.
CASEIN_WORKSPACES_HOST=./workspaces-local

# Postgres credentials. The compose stack provides a Postgres
# service with these defaults baked in.
POSTGRES_USER=casein
POSTGRES_PASSWORD=casein_local_password
POSTGRES_DB=casein_prod

# The HTTP port Casein listens on inside the container.
PORT=4000

# Loopback port exposed by the local Compose stack.
CASEIN_HOST_PORT=4000
