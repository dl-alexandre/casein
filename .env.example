# DevIDE local docker-compose stack — copy to .env and fill in.
#
#   cp .env.example .env
#   docker compose up
#
# The .env file is gitignored. Secrets stay on disk, not in version control.

# ---- Required ----

# Cookie/token signing key. Generate with: mix phx.gen.secret
# (or: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY_BASE=replace-me-with-a-real-64-char-secret

# Bearer token the HTTP API requires.
# Generate with: mix phx.gen.secret
DEV_IDE_API_TOKEN=replace-me-with-a-real-bearer-token

# Bearer token accepted only by fleet runner transport routes.
# Use a different value from DEV_IDE_API_TOKEN for real dogfood/release runs.
DEV_IDE_RUNNER_TOKEN=replace-me-with-a-real-runner-token

# The hostname the operator's browser uses to reach DevIDE.
# For a pure local stack this is localhost; for a real remote
# deploy this is your public domain.
PHX_HOST=localhost

# ---- Optional ----

# Path inside the DevIDE container that workspaces live under.
# Compose bind-mounts ./workspaces-local/ to this path.
DEV_IDE_WORKSPACES_ROOT=/workspaces

# Postgres credentials. The compose stack provides a Postgres
# service with these defaults baked in.
POSTGRES_USER=dev_ide
POSTGRES_PASSWORD=dev_ide_local_password
POSTGRES_DB=dev_ide_prod

# The HTTP port DevIDE listens on inside the container.
PORT=4000
