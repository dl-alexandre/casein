# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
dev_ide-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Local docker-compose env files (secrets live here).
.env
.env.local

# Local workspaces directory that docker-compose bind-mounts.
/workspaces-local/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/
# Playwright helper deps for preview control (package.json + lock are tracked;
# the browser-driving package itself is installed locally / in the image).
/priv/scripts/node_modules/

# Release artifact produced by scripts/build-release.sh (regenerated each build).
/release-out/

# Local Claude Code agent config.
/.claude/


# Local UI design studies — kept on disk, not tracked.
/ui-iterations/
/ui-iterations-v2/
/ui-iterations-v3/

# Dialyzer PLT cache (rebuild with `mix dialyzer`)
/priv/plts/
