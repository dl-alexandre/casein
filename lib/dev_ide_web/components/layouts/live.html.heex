<%!--
  Live layout for the workspace LiveViews. Unlike root.html.heex (rendered once
  from the disconnected mount), this layout is re-rendered on connected diffs, so
  banners driven by connected-time assigns (deploy update / drift, set by
  DeploymentUpdateHook) actually appear. Keep it to fixed-position chrome plus
  {@inner_content}; the LiveViews render their own full-page content.
--%>
<button
  id="browser-alert-opt-in"
  type="button"
  data-devide-notification-permission
  class="browser-alert-opt-in hidden fixed z-[9999] items-center gap-1.5 rounded-lg border border-zinc-300/70 bg-white/95 px-3 py-2 text-xs font-medium text-zinc-800 shadow-lg backdrop-blur transition hover:bg-zinc-50 active:scale-[0.99] dark:border-zinc-700 dark:bg-zinc-950/95 dark:text-zinc-100 dark:hover:bg-zinc-900"
  title="Enable browser alerts"
  aria-label="Enable browser alerts"
>
  <.icon name="hero-bell-alert" class="size-4 text-amber-500" />
  <span>Enable alerts</span>
</button>
<%= if failure = assigns[:deploy_failure] do %>
  <div
    id="deploy-failure-banner"
    class="fixed right-4 top-4 z-[9999] max-w-md rounded-lg border border-rose-500/40 bg-rose-950/95 px-4 py-3 text-sm text-rose-50 shadow-lg backdrop-blur-sm"
  >
    <div class="font-semibold">Deploy failed</div>
    <div class="mt-1 text-xs text-rose-100/85">
      {failure[:message] || failure["message"] || "The on-box deploy poller aborted."}
    </div>
    <div class="mt-2 font-mono text-[10px] text-rose-100/70">
      target: {failure[:target_short] || failure["target_short"] || failure[:target_sha] ||
        failure["target_sha"] || "unknown"}
    </div>
  </div>
<% else %>
  <%= if in_progress = assigns[:deploy_in_progress] do %>
    <div
      id="deploy-in-progress-banner"
      class="fixed right-4 top-4 z-[9999] flex max-w-md animate-pulse items-center gap-2 rounded-lg border border-sky-500/30 bg-sky-950/90 px-4 py-2.5 text-sm text-sky-100 shadow-lg backdrop-blur-sm"
    >
      <span class="size-2 shrink-0 rounded-full bg-sky-400"></span>
      <span>{in_progress[:message] || in_progress["message"] || "Deploy in progress…"}</span>
    </div>
  <% else %>
    <%= if assigns[:update_available] do %>
      <div
        id="deploy-update-banner"
        phx-hook="DeployUpdateBanner"
        class="fixed right-4 top-4 z-[9999] flex animate-pulse items-center gap-2 rounded-lg border border-indigo-500/30 bg-indigo-950/90 px-4 py-2.5 text-sm text-indigo-100 shadow-lg backdrop-blur-sm"
      >
        <span class="size-2 shrink-0 rounded-full bg-indigo-400 animate-none"></span>
        <span>New version available</span>
        <%= if assigns[:update_commits_behind] && assigns[:update_commits_behind] > 0 do %>
          <span class="rounded-full bg-indigo-700 px-1.5 py-0.5 text-[10px] font-semibold tabular-nums">
            {assigns[:update_commits_behind]}
          </span>
        <% end %>
        <button
          onclick="window.sessionStorage.setItem('devide:justUpdated','1');window.location.reload()"
          class="ml-1 rounded bg-indigo-600 px-2.5 py-1 text-xs font-medium text-white hover:bg-indigo-500"
        >
          Update now
        </button>
        <span class="hidden text-[10px] text-indigo-200/80 sm:inline" data-deploy-idle-status></span>
      </div>
    <% end %>
  <% end %>
<% end %>
<%= if drift = assigns[:deploy_drift] do %>
  <% drift_reason = drift[:reason] || drift["reason"] %>
  <%= if drift_reason == :manual_revision or (is_nil(assigns[:deploy_failure]) and is_nil(assigns[:deploy_in_progress])) do %>
    <div
      id="deploy-drift-banner"
      class="fixed right-4 top-20 z-[9999] max-w-md rounded-lg border border-amber-500/40 bg-amber-950/95 px-4 py-3 text-sm text-amber-50 shadow-lg backdrop-blur-sm"
    >
      <div class="font-semibold">Running revision is not durable</div>
      <div class="mt-1 text-xs text-amber-100/85">
        {drift[:message] || drift["message"] || "Running revision differs from origin/master."}
      </div>
      <div class="mt-2 font-mono text-[10px] text-amber-100/70">
        current: {drift[:current] || drift["current"] || "unknown"}
      </div>
      <button
        onclick="window.location.reload()"
        class="mt-2 rounded bg-amber-600 px-2.5 py-1 text-xs font-medium text-white hover:bg-amber-500"
      >
        Sync now
      </button>
    </div>
  <% end %>
<% end %>
{@inner_content}
