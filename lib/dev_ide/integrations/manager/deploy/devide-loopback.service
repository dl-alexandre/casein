# DevIDE loopback HTTP bridge for canary (Unix socket) deploys.
#
# Canary releases listen on /run/devide/instances/<uuid>.sock; Caddy uses
# /run/devide/current.sock. On-box agents and scripts still expect
# http://127.0.0.1:4000 — this unit forwards loopback TCP to the current socket.
#
# Install (via activate_devbox_deploy or ensure-devide-loopback-proxy.sh):
#   sudo cp /opt/devide/deploy/devide-loopback.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now devide-loopback
#
# When devide.service binds :4000 directly (legacy rollback), leave this unit
# stopped — ensure-devide-loopback-proxy.sh detects an existing listener.

[Unit]
Description=DevIDE loopback HTTP proxy (127.0.0.1:4000 → current Unix socket)
Documentation=https://github.com/dl-alexandre/dev_ide/blob/master/lib/dev_ide/integrations/manager/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:127.0.0.1:4000,fork,reuseaddr UNIX-CONNECT:/run/devide/current.sock
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target