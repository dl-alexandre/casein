<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      DeviceLink rejects cleartext non-local origins before persisting a token.
      Android's network security config cannot express RFC1918 address ranges,
      so transport permission is broad here while the credential boundary stays
      narrow in CaseinMob.DeviceLink.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
